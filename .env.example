ENHANCE_PANEL_URL=https://your-panel.example.com
ENHANCE_TOKEN=paste-access-token-from-Settings-Access-Tokens

# live tests (opt-in): creates and soft-deletes a throwaway site on this subscription
ENHANCE_E2E=0
ENHANCE_E2E_SUBSCRIPTION_ID=
# optional for milestone A: use a subdomain you control instead of mcp-e2e-<rand>.test
# REQUIRED for milestone B: it must name an EXISTING website (e.g. vahi.dev). That suite creates
# no site; it makes throwaway `mcpb<5 random chars>` databases, MySQL users and one cron line on
# the site named here, and deletes each one again. It also leaves one gzipped SQL dump
# (sql_backup_...mcpb....sql.gz) in that website's home directory, which only SSH can remove.
ENHANCE_E2E_DOMAIN=
