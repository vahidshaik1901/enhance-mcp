ENHANCE_PANEL_URL=https://your-panel.example.com
ENHANCE_TOKEN=paste-access-token-from-Settings-Access-Tokens

# Live tests (opt-in). `npm run test:e2e` runs BOTH suites against the real panel:
#   milestone A creates and soft-deletes a throwaway `.test` site on ENHANCE_E2E_SUBSCRIPTION_ID
#   milestone B writes randomised `mcpb…` resources on the EXISTING site named by ENHANCE_E2E_SITE
# Run one suite alone with, e.g.
#   npx vitest run --config vitest.e2e.config.ts test/e2e/milestone-b.e2e.test.ts
ENHANCE_E2E=0

# Milestone A, required: the subscription the throwaway site is created under.
ENHANCE_E2E_SUBSCRIPTION_ID=
# Milestone A, optional: a FREE domain to create, instead of the default mcp-e2e-<rand>.test.
# It must not exist yet — the suite creates it and soft-deletes it again.
ENHANCE_E2E_DOMAIN=

# Milestone B, required: an EXISTING website (e.g. vahi.dev). That suite creates no site; it makes
# throwaway `mcpb<5 random chars>` databases, MySQL users and one cron line on the site named here,
# and deletes each of them again. Two things it leaves behind on purpose:
#   - one gzipped dump (sql_backup_...mcpb....sql.gz) in that website's home directory, which only
#     SSH can remove;
#   - the panel's own persistent `<unixUser>_phpma` MySQL user, which the panel creates on the first
#     db_phpmyadmin_url (phpMyAdmin SSO) call. It belongs to the panel and the suite leaves it alone.
ENHANCE_E2E_SITE=
